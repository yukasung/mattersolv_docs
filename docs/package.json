{
  "name": "mattersolv-docs",
  "author": "MatterSolv Documentation",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "database:django-auth:verify": "node scripts/verify-database-django-auth.mjs",
    "database:commercial-constraints:verify": "node scripts/verify-database-commercial-constraints.mjs",
    "database:tenant-isolation:verify": "node scripts/verify-database-tenant-isolation.mjs",
    "database:identifiers:verify": "node scripts/verify-database-identifiers.mjs",
    "dev": "next dev",
    "questions:test": "node --test --experimental-strip-types app/docs/questions/_lib/*.test.ts",
    "questions:verify": "node scripts/verify-question-snapshot.mjs",
    "postbuild": "next-sitemap && pagefind --site .next/server/app --output-path public/_pagefind",
    "postinstall": "patch-package",
    "start": "next start"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "clsx": "^2.1.0",
    "next": "16.0.7",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "next-sitemap": "^4.2.3",
    "pagefind": "^1.3.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "4.1.10",
    "typescript": "5.9.3"
  },
  "browserslist": [
    ">= .25%",
    "not dead"
  ]
}
